// Grafana Alloy ships the stdout/stderr and resource metrics of every
// container running on this node to Grafana Cloud (Loki + Prometheus).
// Deployed in global mode so one instance runs per Swarm node.

// ---------------------------------------------------------
// Container Logs -> Grafana Cloud Loki
// ---------------------------------------------------------

// Discover every running container on this node through the Docker API.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name   = "status"
    values = ["running"]
  }
}

// Turn Docker/Swarm metadata into the labels we query by in Grafana.
// Labels are kept deliberately few to avoid high cardinality in Loki.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Container name, without the leading slash. Used as the fallback service
  // name for containers started outside of swarm.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service"
  }

  // For swarm managed containers the service name is the useful identity
  // (infra_caddy, infra_mqtt, ...). Only overwrites when the label exists.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  // Stack the service belongs to: infra, nu31space, prismo, ...
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_stack_namespace"]
    regex         = "(.+)"
    target_label  = "stack"
  }

  // Swarm node this container runs on. `hostname` is set to {{.Node.Hostname}}
  // in the stack file, so it matches the node name shown by `docker node ls`.
  rule {
    target_label = "node"
    replacement  = constants.hostname
  }
}

// Stream the container logs from the Docker API into the processing pipeline.
loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  forward_to       = [loki.process.containers.receiver]
  refresh_interval = "15s"
}

loki.process "containers" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // Drop the empty lines many images print on startup, they are pure noise
  // in the log panel.
  stage.drop {
    expression = "^\\s*$"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_API_KEY")
    }
  }
}

// ---------------------------------------------------------
// Container Resource Metrics -> Grafana Cloud Prometheus
// ---------------------------------------------------------

prometheus.exporter.cadvisor "docker" {
  docker_host            = "unix:///var/run/docker.sock"
  store_container_labels = true
  docker_only            = true
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  forward_to      = [prometheus.relabel.containers.receiver]
  scrape_interval = "60s"
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Keep only the essential per-container resource metrics to stay well within
  // Grafana Cloud active series limits.
  rule {
    source_labels = ["__name__"]
    regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_spec_memory_limit_bytes|container_network_(receive|transmit)_bytes_total|container_fs_(reads|writes)_bytes_total|container_last_seen"
    action        = "keep"
  }

  // Map Swarm labels to friendly `service`, `stack`, and `node` labels matching Loki.
  rule {
    source_labels = ["name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["container_label_com_docker_swarm_service_name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["container_label_com_docker_stack_namespace"]
    regex         = "(.+)"
    target_label  = "stack"
  }

  rule {
    target_label = "node"
    replacement  = constants.hostname
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROMETHEUS_USER")
      password = sys.env("GRAFANA_API_KEY")
    }
  }
}
