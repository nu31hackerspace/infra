// Grafana Alloy ships the resource metrics of every container running on this
// node to Grafana Cloud Prometheus. Container logs are not shipped anywhere,
// they are browsed live with Dozzle (see the `dozzle` service).
// Deployed in global mode so one instance runs per Swarm node.

// ---------------------------------------------------------
// Container Resource Metrics -> Grafana Cloud Prometheus
// ---------------------------------------------------------

prometheus.exporter.cadvisor "docker" {
  docker_host            = "unix:///var/run/docker.sock"
  store_container_labels = true
  docker_only            = true
  // Only collect in-memory cgroup stats (CPU, memory, network).
  // Disables the "disk" collector which otherwise walks /var/lib/docker/overlay2
  // and causes multi-GB disk reads.
  enabled_metrics        = ["cpu", "memory", "network"]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  forward_to      = [prometheus.relabel.containers.receiver]
  scrape_interval = "60s"
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Keep only the essential per-container resource metrics to stay well within
  // Grafana Cloud active series limits.
  rule {
    source_labels = ["__name__"]
    regex         = "container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_spec_memory_limit_bytes|container_network_(receive|transmit)_bytes_total|container_last_seen"
    action        = "keep"
  }

  // Map Swarm labels to friendly `service`, `stack`, and `node` labels.
  rule {
    source_labels = ["name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["container_label_com_docker_swarm_service_name"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["container_label_com_docker_stack_namespace"]
    regex         = "(.+)"
    target_label  = "stack"
  }

  rule {
    target_label = "node"
    replacement  = constants.hostname
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROMETHEUS_USER")
      password = sys.env("GRAFANA_API_KEY")
    }
  }
}
